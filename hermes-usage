#!/usr/bin/env python3
"""hermes-usage: show LLM token usage recorded in the Hermes state.db.

Usage:
  hermes-usage                 current session (most recently active)
  hermes-usage --session ID    specific session
  hermes-usage --all           totals across all sessions
  hermes-usage --list          list sessions with usage

Reads read-only so it never locks the live gateway database.
"""
import argparse
import os
import sqlite3
import sys
from datetime import datetime

HOME = os.environ.get("HERMES_HOME", os.path.expanduser("~/.hermes"))
DB = os.path.join(HOME, "state.db")

COLS = ["input_tokens", "output_tokens", "cache_read_tokens",
        "cache_write_tokens", "reasoning_tokens"]


def connect():
    if not os.path.exists(DB):
        sys.exit(f"state.db not found at {DB}")
    return sqlite3.connect(f"file:{DB}?mode=ro", uri=True)


def fmt(n):
    return f"{(n or 0):,}"


def total(row):
    return sum(row[c] or 0 for c in COLS)


def print_breakdown(db, where="", args=()):
    rows = db.execute(
        "SELECT model, task, api_call_count, input_tokens, output_tokens,"
        " cache_read_tokens, cache_write_tokens, reasoning_tokens,"
        " estimated_cost_usd, actual_cost_usd"
        f" FROM session_model_usage {where} ORDER BY api_call_count DESC",
        args).fetchall()
    if not rows:
        print("no usage rows")
        return
    agg = {c: 0 for c in COLS}
    calls = 0
    for (model, task, calls_n, i, o, cr, cw, r, est, act) in rows:
        tag = f" [{task}]" if task else ""
        print(f"- {model}{tag}: calls={calls_n or 0} "
              f"in={fmt(i)} out={fmt(o)} cache_read={fmt(cr)} "
              f"cache_write={fmt(cw)} reasoning={fmt(r)}")
        calls += calls_n or 0
        for c, v in zip(COLS, (i, o, cr, cw, r)):
            agg[c] += v or 0
    grand = sum(agg.values())
    print(f"TOTAL: calls={calls} " + " ".join(f"{c}={fmt(v)}" for c, v in agg.items())
          + f" grand_total={fmt(grand)}")


def current_session_id(db):
    r = db.execute("SELECT id FROM sessions ORDER BY last_activity_at DESC LIMIT 1").fetchone()
    return r[0] if r else None


def main():
    ap = argparse.ArgumentParser(description="Show Hermes LLM token usage")
    ap.add_argument("--session", help="session id")
    ap.add_argument("--all", action="store_true", help="totals across all sessions")
    ap.add_argument("--list", action="store_true", help="list sessions with usage")
    a = ap.parse_args()
    db = connect()

    if a.list:
        for (sid, src, name, model, msgs, calls, i, o, cr, cw, r, last) in db.execute(
                "SELECT id, source, display_name, model, message_count, api_call_count,"
                " input_tokens, output_tokens, cache_read_tokens, cache_write_tokens,"
                " reasoning_tokens, last_activity_at FROM sessions"
                " ORDER BY last_activity_at DESC"):
            t = sum(x or 0 for x in (i, o, cr, cw, r))
            ts = datetime.fromtimestamp(last).strftime("%m-%d %H:%M") if last else "?"
            print(f"{sid} | {src}/{name} | {model} | msgs={msgs} calls={calls} "
                  f"tokens={fmt(t)} | {ts}")
        return

    if a.all:
        print("== all sessions ==")
        print_breakdown(db)
        return

    sid = a.session or current_session_id(db)
    info = db.execute("SELECT source, display_name, model, message_count,"
                      " api_call_count FROM sessions WHERE id=?", (sid,)).fetchone()
    if info:
        print(f"== session {sid} ({info[0]}/{info[1]}, {info[2]},"
              f" msgs={info[3]}, calls={info[4]}) ==")
    else:
        print(f"== session {sid} (not in sessions table) ==")
    print_breakdown(db, "WHERE session_id=?", (sid,))


if __name__ == "__main__":
    main()
